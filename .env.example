# Token du bot Discord (https://discord.com/developers/applications)
DISCORD_TOKEN=ton_token_ici

# ID du client (Application ID)
CLIENT_ID=ton_client_id_ici

# ID du serveur (Guild ID) où le bot sera utilisé
GUILD_ID=ton_guild_id_ici

# Clé API OpenAI / xAI / compatible OpenAI (Grok, Claude via proxy, etc.)
OPENAI_API_KEY=sk-...

# Base URL de l'API (laisser vide pour OpenAI officiel)
# Pour xAI Grok : https://api.x.ai/v1
# Pour OpenAI : https://api.openai.com/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# Modèle à utiliser
# OpenAI : gpt-4o-mini / gpt-4o
# xAI    : grok-beta / grok-2-latest
AI_MODEL=gpt-4o-mini

# Prompt système de l'IA (personnalisable)
AI_SYSTEM_PROMPT=Tu es un assistant de support professionnel et amical. Tu réponds clairement, de façon concise et utile. Si tu ne peux pas résoudre le problème, propose des solutions alternatives ou oriente l'utilisateur. Ne révèle jamais que tu es une IA sauf si on te le demande directement. Réponds toujours en français sauf si l'utilisateur écrit dans une autre langue.
