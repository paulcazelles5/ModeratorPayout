# ==================== DISCORD ====================
DISCORD_TOKEN=your_discord_bot_token

# ==================== AI (Groq) ====================
OPENAI_API_KEY=gsk_your_groq_key
OPENAI_BASE_URL=https://api.groq.com/openai/v1

# Free models currently available on Groq (Oct 2026):
# openai/gpt-oss-20b
# openai/gpt-oss-120b
# qwen/qwen3.8-27b
AI_MODEL=openai/gpt-oss-20b

# Optional
# AI_SYSTEM_PROMPT=You are a professional and friendly support assistant. Always reply in English.
